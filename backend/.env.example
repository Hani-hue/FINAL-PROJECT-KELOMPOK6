# Dipakai oleh scripts/telegram-poll.js & scripts/cron-keterlambatan.js.
# Ambil SUPABASE_ANON_KEY dari output `npx supabase status` setelah `supabase start`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Bot Telegram untuk konfirmasi admin (lihat CLAUDE.md §8). Dipakai scripts/telegram-poll.js
# untuk long polling getUpdates. BOT_TOKEN & BOT_ADMIN_CHAT_ID yang dipakai Edge Function
# (telegram-notify & telegram-webhook) diset terpisah lewat `supabase secrets set`, BUKAN dari
# file ini — lihat backend/README.md.
TELEGRAM_BOT_TOKEN=
